  "components": {
    "schemas": {
      "AckRequest": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id"
          },
          "lease": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Lease"
          },
          "status": {
            "type": "string",
            "enum": [
              "played",
              "failed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "lease",
          "status"
        ],
        "title": "AckRequest",
        "description": "ESP32 gửi kết quả sau khi phát xong hoặc gặp lỗi."
      },
      "DeviceUpdate": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Device Id"
          },
          "token": {
            "type": "string",
            "maxLength": 200,
            "title": "Token",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "DeviceUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PreviewRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "PreviewRequest"
      },
      "SpeakRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Device Id"
          },
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          },
          "volume": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Volume",
            "default": 70
          },
          "priority": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "text"
        ],
        "title": "SpeakRequest",
        "description": "Ứng dụng gửi văn bản này cho backend để tạo một lượt phát."
      },
      "TTSUpdate": {
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^(|tone|http)$",
            "title": "Provider",
            "default": ""
          },
          "tts_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Tts Url",
            "default": ""
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "clear_api_key": {
            "type": "boolean",
            "title": "Clear Api Key",
            "default": false
          },
          "voice": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Voice",
            "default": "default"
          },
          "model": {
            "type": "string",
            "maxLength": 160,
            "title": "Model",
            "default": ""
          },
          "format": {
            "type": "string",
            "pattern": "^(pcm|wav|mp3)$",
            "title": "Format",
            "default": "pcm"
          },
          "auth_header": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,80}$",
            "title": "Auth Header",
            "default": "Authorization"
          },
          "auth_prefix": {
            "type": "string",
            "maxLength": 80,
            "title": "Auth Prefix",
            "default": "Bearer"
          },
          "body_template": {
            "additionalProperties": true,
            "type": "object",
            "title": "Body Template"
          }
        },
        "type": "object",
        "title": "TTSUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}