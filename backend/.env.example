# Load these as environment variables before starting uvicorn. This file is not auto-loaded.
SPEAKER_API_KEY=
# JSON object: device ID -> unique token. Never use the operator API key as a device token.
SPEAKER_DEVICES={"speaker-01":""}
SPEAKER_DATA_DIR=backend/data
# Empty = TTS not configured (503). "tone" explicitly enables a test beep, not speech.
# "http" POSTs {text, voice, format: pcm_s16le, sample_rate: 24000} to TTS_URL.
TTS_PROVIDER=
TTS_URL=
TTS_API_KEY=
# For an existing provider returning binary WAV/MP3, set TTS_RESPONSE_FORMAT and install ffmpeg.
TTS_RESPONSE_FORMAT=pcm
TTS_VOICE=default
TTS_REVISION=1
# Optional: URL/IP that ESP32 can reach; the demo launcher detects LAN IP automatically.
SPEAKER_PUBLIC_URL=
# Dashboard saves TTS/device settings in SPEAKER_DATA_DIR/speaker.sqlite3.
# Saved dashboard settings take precedence over the initial TTS environment values.
