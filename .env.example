# Sao chép thành .env ở thư mục gốc repo trước khi chạy Docker Compose.
DASHBOARD_PORT=8088
# Thay YOUR_SERVER_IP bằng IP LAN/domain của máy chạy Docker.
# Nếu đổi DASHBOARD_PORT, đổi cả cổng ở URL này.
SPEAKER_PUBLIC_URL=http://YOUR_SERVER_IP:8088

# Local: de mac dinh image ben duoi. Server: doi thanh image GHCR da build.
SPEAKER_IMAGE=dsoft-audiotts-backend:local
# SPEAKER_IMAGE=ghcr.io/tranvanha-tyranno/dsoft-audiotts-backend:latest

# Khóa operator/device được tạo tự động trong Docker volume.
# Cấu hình API TTS được nhập trên dashboard và lưu trong cùng volume.
