{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "P01: Mo dashboard web demo",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dashboard.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "P01: Build ESP32-S3",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "P01: Tu nap ESP32-S3 (auto reset)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1", "-Action", "flash", "-Port", "${input:speakerPort}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "P01: Mo code cau hinh WiFi - Server",
            "type": "process",
            "command": "${execPath}",
            "args": ["--reuse-window", "${workspaceFolder}/main/speaker_config.local.h"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "P01: Kiem thu backend",
            "type": "process",
            "command": "python",
            "args": ["-m", "pytest", "backend/tests", "-q"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "speakerPort",
            "type": "promptString",
            "description": "Cong COM cua ESP32-S3",
            "default": "COM7"
        }
    ]
}
